# Overseas Demand Radar - environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database ---
DATABASE_PATH=data/overseas_demand_radar.db

# --- Business defaults ---
# Target net margin (percentage). Candidates below this are not auto-verified.
TARGET_MARGIN_PCT=20.0
# Base currency for all cost calculations.
BASE_CURRENCY=KRW

# --- External APIs (Phase 2+). Leave blank in Phase 1. ---
# These keys are read from the environment only; never hardcode secrets.
# NAVER API HUB (NAVER Cloud Platform) — search trend / shopping insight.
# Register an Application in the NCP console (All Services > Application Services >
# NAVER API HUB > Application), enable "검색어 트렌드" and "쇼핑 인사이트", then copy
# Client ID / Client Secret from the Application's "인증 정보".
# Keys from developers.naver.com do NOT work with NAVER API HUB.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Safety cap on API calls per collection run.
NAVER_MAX_CALLS_PER_RUN=50
# Optional: a SEPARATE NAVER API HUB Application for Shopping Insight (쇼핑 인사이트).
# Fill these in only if Shopping Insight is enabled on a different Application than
# the search-trend one above. Leave blank to reuse NAVER_CLIENT_ID / NAVER_CLIENT_SECRET.
# Set both or neither; a half-filled pair is ignored.
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=
# Anchor keyword added to every search-trend request (its recent level = 50).
NAVER_ANCHOR_KEYWORD=해외직구
# Note: the Naver shopping search API (domestic prices) ended on 2026-07-31 with no
# replacement. Provide domestic prices via data/sample-style domestic_offers.csv.

# --- Overseas supplier search (Phase 3, optional) ---
# eBay Developers Program (https://developer.ebay.com) -> Application Keys
# (Production). Uses the Browse API with an Application access token.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Only listings that can be shipped to this country are returned.
EBAY_DELIVERY_COUNTRY=KR
# Rakuten Web Service (https://webservice.rakuten.co.jp) -> New App.
# Both the application ID and the access key are required.
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# Safety caps per search run (per source) and per product.
SUPPLIER_MAX_CALLS_PER_RUN=40
SUPPLIER_MAX_QUERIES_PER_PRODUCT=3

# --- Optional local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Logging ---
LOG_LEVEL=INFO
